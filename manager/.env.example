# Ambiente ativo: development | production
# Se omitido, usa NODE_ENV (dev local / production no deploy)
NEXT_PUBLIC_APP_ENV=development

# URLs da API por ambiente
NEXT_PUBLIC_API_URL_DEV=http://localhost:3333
NEXT_PUBLIC_API_URL_PROD=https://your-api.up.railway.app

# Deploy (Production): configure as mesmas variaveis na Vercel
# e NEXT_PUBLIC_API_URL_PROD nos GitHub Secrets do repositorio.
