# PostgreSQL (docker compose: postgres/postgres, db: cogni-cash)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cogni-cash"

# Porta da API
PORT=3333

# Chaves RSA em base64 (gerar com: openssl genrsa 2048 | base64 -w 0)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Analista financeiro
# Claude Haiku (testes): base abaixo + modelo claude-haiku-4-5
# OpenAI: AI_BASE_URL=https://api.openai.com/v1 e AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-haiku-4-5
