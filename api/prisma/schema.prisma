generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

enum Plans {
  FREE
  PREMIUM
}

enum AccountMemberRole {
  OWNER
  DEPENDENT
  VIEWER
}

model Whitelabel {
  id        String   @id @default(uuid())
  name      String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  accounts Account[]
  invites  MemberInvite[]

  @@map("whitelabels")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String
  password     String
  telephone    String?
  whitelabelId String   @map("whitelabel_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  whitelabel          Whitelabel     @relation(fields: [whitelabelId], references: [id], onDelete: Cascade)
  memberships         AccountMember[]
  createdTransactions Transaction[]  @relation("transaction_creator")
  sentInvites         MemberInvite[] @relation("sent_invites")

  @@unique([whitelabelId, email])
  @@map("users")
}

model Account {
  id           String   @id @default(uuid())
  name         String?
  plan         Plans    @default(FREE)
  whitelabelId String   @map("whitelabel_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  whitelabel   Whitelabel      @relation(fields: [whitelabelId], references: [id], onDelete: Cascade)
  members      AccountMember[]
  transactions Transaction[]
  categories   Category[]
  budgets      Budget[]
  goals        Goal[]
  invites      MemberInvite[]

  @@index([whitelabelId])
  @@map("accounts")
}

model AccountMember {
  id        String            @id @default(uuid())
  role      AccountMemberRole @default(DEPENDENT)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@map("account_members")
}

model MemberInvite {
  id         String            @id @default(uuid())
  email      String
  token      String            @unique @default(uuid())
  role       AccountMemberRole @default(DEPENDENT)
  expiresAt  DateTime          @map("expires_at")
  acceptedAt DateTime?         @map("accepted_at")
  createdAt  DateTime          @default(now()) @map("created_at")

  accountId    String @map("account_id")
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  whitelabelId String     @map("whitelabel_id")
  whitelabel   Whitelabel @relation(fields: [whitelabelId], references: [id], onDelete: Cascade)
  invitedById  String     @map("invited_by_id")
  invitedBy    User       @relation("sent_invites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([whitelabelId, email, accountId])
  @@map("member_invites")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  budgets      Budget[]

  @@map("categories")
}

enum transactionType {
  EXPENSE
  INCOME
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  type   transactionType
  source String?

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  createdBy String @map("created_by")
  creator   User   @relation("transaction_creator", fields: [createdBy], references: [id])

  @@index([accountId])
  @@index([date])
  @@map("transactions")
}

model Budget {
  id String @id @default(uuid())

  limit Decimal @db.Decimal(10, 2)

  month Int
  year  Int

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId, categoryId, month, year])
  @@map("budgets")
}

model Goal {
  id String @id @default(uuid())

  title String

  targetAmount  Decimal @db.Decimal(10, 2)
  currentAmount Decimal @default(0) @db.Decimal(10, 2)

  deadline DateTime?

  slug String @unique

  accountId String  @map("account_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("goals")
}
